[Unit]
Description=SnapNPlan web app (gunicorn)
After=network.target

[Service]
User=snapnplan
# nginx runs as www-data and serves the uploads and static files, so new
# files get that group and are readable by it (and by nobody else).
Group=www-data
UMask=0027
WorkingDirectory=/srv/snapnplan/app
# One process, several threads: each process loads its own copy of the
# TensorFlow page classifier (about 0.9 GB), and requests mostly wait on the
# question-writing APIs, so threads give the concurrency without the memory.
ExecStart=/srv/snapnplan/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8001 --workers 1 --threads 4 --timeout 150 \
    --access-logfile - --error-logfile -
Environment=TF_CPP_MIN_LOG_LEVEL=2
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
